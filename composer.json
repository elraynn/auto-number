{
    "name": "elrayn/auto-number",
    "description": "Generate sequential document numbers (invoice, PO, etc.) without the race condition in SELECT MAX() + 1",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Muhammad Rayhan"
        }
    ],
    "require": {
        "php": ">=7.4",
        "ext-pdo": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    },
    "autoload": {
        "psr-4": {
            "Elrayn\\AutoNumber\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Elrayn\\AutoNumber\\Tests\\": "tests/"
        }
    }
}
